# Docker deployment configuration: copy to .env.
# Compose builds ScopeWeaver locally from this checkout.
SCOPEWEAVER_LANGUAGE=en
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# Set either/both LLM keys, or configure them later in the application.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=

# Native Ollama is optional; cloud providers and external compatible endpoints remain supported.
# For host Ollama from Docker: http://host.docker.internal:11434
# For the optional Compose service: http://ollama:11434
OLLAMA_API_KEY=

# Optional generic credential override; leave this unset to use provider-specific keys.
# SCOPEWEAVER_LLM_API_KEY=your-key
SCOPEWEAVER_LLM_PROVIDER=
SCOPEWEAVER_LLM_MODEL=
SCOPEWEAVER_LLM_BASE_URL=
SCOPEWEAVER_LLM_PROXY=
SCOPEWEAVER_LOCAL_LLM_ONLY=false
# Optional native runtime overrides (unset uses provider defaults).
SCOPEWEAVER_LLM_CONTEXT_WINDOW_K=
SCOPEWEAVER_LLM_KEEP_ALIVE=
SCOPEWEAVER_LLM_MAX_CONCURRENT=
# Optional extra VPN/private network CIDRs when strict local mode is enabled.
SCOPEWEAVER_LOCAL_LLM_ALLOWED_CIDRS=

# Claude subscription (Pro/Max) through the official Claude Code CLI, no API key:
#   SCOPEWEAVER_LLM_PROVIDER=claude-code
#   SCOPEWEAVER_LLM_MODEL=claude-sonnet-5-5   (or claude-opus-5-5 / claude-haiku-5-5)
# then sign in once: docker compose exec -it scopeweaver claude   and run /login.
# Concurrent CLI processes; usage counts against your plan's limits.
SCOPEWEAVER_CLAUDE_CODE_MAX_PROCS=1

# Host address the UI port binds to (loopback by default).
SCOPEWEAVER_BIND=127.0.0.1
